{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the launcher UI in the main window may call. The Grafana iframe gets nothing.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "allow-get-status",
    "allow-subscribe-logs",
    "allow-log-history",
    "allow-start-zebrad",
    "allow-start-zebrad-killing-stale",
    "allow-stop-zebrad",
    "allow-restart-zebrad",
    "allow-read-config",
    "allow-apply-config",
    "allow-get-settings",
    "allow-set-settings",
    "allow-get-node-stats",
    "allow-open-path",
    "allow-get-first-run-info",
    "allow-pick-data-dir",
    "allow-choose-data-dir",
    "allow-import-legacy-state",
    "allow-delete-node-data",
    "allow-copy-diagnostics",
    "allow-complete-first-run"
  ]
}
