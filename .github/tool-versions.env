# Tool pins and shared settings for the bundle jobs of bundle.yml and
# release.yml. The setup-tauri action (.github/actions/setup-tauri) loads this
# file into $GITHUB_ENV, so every later step of the job sees these variables.
# Format: KEY=value lines, unquoted, one line each; `#` comments and blank
# lines are skipped. The five-target matrix is in .github/targets.json.

# tauri-cli, trunk, wasm-bindgen and wasm-opt are installed from their GitHub
# release binaries, each checked against the sha256 below before it runs
# (setup-tauri). Change a version and its hashes together:
# scripts/refresh-tool-pins.sh recomputes them (docs/DEVELOPMENT.md).

# tauri-cli's MAJOR.MINOR must match the tauri crate in Cargo.lock
# (scripts/check-versions.sh checks it): the CLI that bundles the app must
# match the runtime it was built against.
#
# Assets: https://github.com/tauri-apps/tauri/releases/tag/tauri-cli-v<version>,
# cargo-tauri-<triple>.tgz (Linux) or .zip (macOS, Windows). The release ships
# no checksum file, so these hashes were computed from the downloaded assets
# (2026-10-23); they equal the `digest` GitHub reports for each asset:
#   gh api repos/tauri-apps/tauri/releases/tags/tauri-cli-v<version> \
#     --jq '.assets[] | [.name, .digest] | @tsv'
TAURI_CLI_VERSION=2.12.4
TAURI_CLI_SHA256_X86_64_UNKNOWN_LINUX_GNU=820ae3c7580ca637cad15f65638960ee2a96e5a491e224691c86d6f25e6c9e8a
TAURI_CLI_SHA256_AARCH64_UNKNOWN_LINUX_GNU=4f601b9f462c3d3d10ce67b6ae963f099f6a5a3253920dae95a253abd558d723
TAURI_CLI_SHA256_AARCH64_APPLE_DARWIN=f71a34ada728ca2d1a51c28d6d21639e1e080898ec69ec8d49c5da3b7e8bc1be
TAURI_CLI_SHA256_X86_64_APPLE_DARWIN=164d184c0e50800dcae7bb31f0815066ebd27efc3e3bb73117974bcd2e982192
TAURI_CLI_SHA256_X86_64_PC_WINDOWS_MSVC=3e8687fb184bd7f10ebd8642f7715f79f4a605c0694c142a21507e8a24dc0f8b

# Assets: https://github.com/trunk-rs/trunk/releases/tag/v<version>,
# trunk-<triple>.tar.gz (Linux, macOS) or .zip (Windows). On Linux the static
# musl build: the glibc build needs GLIBC_2.39 symbols, above the 2.35 of the
# ubuntu:22.04 container. Hashes from the release's own <asset>.sha256 files
# (checked against the downloaded assets, 2026-10-23).
TRUNK_VERSION=0.22.0
TRUNK_SHA256_X86_64_UNKNOWN_LINUX_MUSL=7210c507cea0ee8c9296883802ce7ce50c08a38e7ed67993c2ea41ffddb89b79
TRUNK_SHA256_AARCH64_UNKNOWN_LINUX_MUSL=bc96ce14d51a0b9414863f04b4bf42cd496d3b3ea8b7ea7512fcbd24294f33a7
TRUNK_SHA256_AARCH64_APPLE_DARWIN=9a120ec52021e235c30650d700979c99b572cef68ada8aa3f44735b8b29fa411
TRUNK_SHA256_X86_64_APPLE_DARWIN=6e6d2d5180fd7eaaf3fb4d2918ba1a6d57365d480c2372444cdeede97d56a519
TRUNK_SHA256_X86_64_PC_WINDOWS_MSVC=4a9c5f1967e5563b277802186a836fd6f95fb455a8d4a0c1ed15cc8437187690

# wasm-bindgen (the CLI) and wasm-opt (binaryen), which trunk runs on the
# frontend that is embedded in the app. setup-tauri (compile: "true") installs
# them first on PATH and sets TRUNK_OFFLINE=true and
# TRUNK_TOOLS_WASM_OPT=${BINARYEN_VERSION}: offline, trunk downloads nothing
# and accepts a tool on PATH only at exactly the version it requires
# (wasm-bindgen: the `wasm-bindgen` crate in Cargo.lock; wasm-opt:
# TRUNK_TOOLS_WASM_OPT), and fails otherwise. Hashes computed from the
# downloaded assets (2026-10-23); each equals the release's own
# <asset>.sha256sum / <asset>.sha256 file and the `digest` GitHub reports:
#   gh api repos/<owner>/<repo>/releases/tags/<version> \
#     --jq '.assets[] | [.name, .digest] | @tsv'

# WASM_BINDGEN_VERSION must equal the `wasm-bindgen` crate in Cargo.lock
# (scripts/check-versions.sh and setup-tauri check it): bump it, and its
# hashes, with the crate.
# Assets: https://github.com/wasm-bindgen/wasm-bindgen/releases/tag/<version>,
# wasm-bindgen-<version>-<triple>.tar.gz; on Linux the static musl builds.
WASM_BINDGEN_VERSION=0.2.129
WASM_BINDGEN_SHA256_X86_64_UNKNOWN_LINUX_MUSL=82d12bb940e2d4e72e0d5605387fc1b8ca179044e012b620f0ce4e7440e8320e
WASM_BINDGEN_SHA256_AARCH64_UNKNOWN_LINUX_MUSL=2ed4351c35dd9440308bbb02767d47ea278efe851a52465300f3c94f5b6c2a87
WASM_BINDGEN_SHA256_AARCH64_APPLE_DARWIN=81d4a23d56b3c3eb8187658329116d50e0b228a93b343825fb71f70179051cd1
WASM_BINDGEN_SHA256_X86_64_APPLE_DARWIN=7e028879a68ec53dae14048b55cc5215f6df75b17a9c1426fac8fa086d3202fd
WASM_BINDGEN_SHA256_X86_64_PC_WINDOWS_MSVC=79e348c169d0c10c0b287647f1e753d0985353ca96800bc29be8f4261baf13e6

# BINARYEN_VERSION is the wasm-opt that trunk 0.22.0 downloads by default
# (`Application::WasmOpt` default_version in trunk's src/tools.rs); re-check
# it when TRUNK_VERSION changes.
# Assets: https://github.com/WebAssembly/binaryen/releases/tag/<version>,
# binaryen-<version>-<arch>-<os>.tar.gz (arm64-macos on Apple Silicon).
BINARYEN_VERSION=version_131
BINARYEN_SHA256_X86_64_LINUX=b5bf1f0eaf17c63ee588ff7a5954dc8f6ce2c26989051c66f24dfe9ece3e46db
BINARYEN_SHA256_AARCH64_LINUX=ba991f677edd9a21d2bc96c0144bc8ac5b112d4d98a3eb266e075e22e557df2a
BINARYEN_SHA256_ARM64_MACOS=e441b48dc22163d209b4f05e44dc7210909b01237642b6c9ae48fd710a3ef83e
BINARYEN_SHA256_X86_64_MACOS=d209fadd8a894bdaf3bd3612a23c32a0af184d2f4a979b8c789e6e4f6a4de883
BINARYEN_SHA256_X86_64_WINDOWS=2f4edac1703a2f695254d6ff52ede03481e67db1f094915763d863158c17d9bc

# The app's main binary (tauri.conf.json mainBinaryName).
APP_BIN=zebra-launcher

# Linux bundles are built in ubuntu:22.04 containers (.github/targets.json) to
# keep the glibc floor at Ubuntu 22.04's 2.35, which scripts/check-glibc.sh
# enforces. (The ubuntu-22.04 runner labels retire on 2027-04-17.)
GLIBC_FLOOR=2.35

# Build and runtime packages for the ubuntu:22.04 container.
LINUX_PACKAGES=libwebkit2gtk-4.1-dev libayatana-appindicator3-dev librsvg2-dev libxdo-dev libssl-dev patchelf file libfuse2 curl git build-essential pkg-config ca-certificates jq
